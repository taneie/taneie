DATABASE_URL="postgresql://frichy:frichy@localhost:5432/frichy?schema=public"
API_PORT=8787
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
NUXT_APP_BASE_URL="/"
NUXT_PUBLIC_API_BASE="http://127.0.0.1:8787/api"
# ローカル画面からデプロイ済みDev環境を使う場合:
# NUXT_PUBLIC_API_BASE="https://<dev-api-host>/api"
NUXT_PUBLIC_RESUME_UPLOAD_MAX_BYTES="10485760"
NUXT_PUBLIC_SHOW_DEMO_LOGIN="false"
VITE_API_BASE="http://127.0.0.1:8787/api"
PRIVACY_POLICY_VERSION="2026-06-10"
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:admin@example.com"
DATA_ENCRYPTION_KEY=""
BLOB_READ_WRITE_TOKEN=""
# ローカルAPIでBlob tokenを発行し、完了通知だけDev APIへ送る場合:
# BLOB_UPLOAD_CALLBACK_URL="https://<dev-api-host>/api/resumes/blob-upload"
BLOB_UPLOAD_CALLBACK_URL=""
RESUME_UPLOAD_MAX_BYTES="10485760"
GCS_BUCKET_NAME=""

# Google Cloud + Neon 本番環境例:
# DATABASE_URL="postgresql://<user>:<password>@<neon-prod-host>/<db>?sslmode=require"
# CORS_ORIGIN="https://<production-domain-or-cloud-run-url>"
# NUXT_PUBLIC_API_BASE="/api"
# NUXT_PUBLIC_SHOW_DEMO_LOGIN="false"
# BLOB_UPLOAD_CALLBACK_URL="https://<production-domain-or-cloud-run-url>/api/resumes/blob-upload"
# GCS_BUCKET_NAME="frichy-322534405950-resumes"

# Vercel + Neon 開発環境:
# Vercel側の NUXT_PUBLIC_API_BASE は開発APIの /api URLを指定する。
# Vercel側の NUXT_PUBLIC_SHOW_DEMO_LOGIN は true を指定する。
# Dev API側の DATABASE_URL は既存Neon Dev DBを指定する。
# 開発環境では GCS_BUCKET_NAME / BLOB_READ_WRITE_TOKEN は未設定でよい。
# その場合、レジュメアップロードだけ利用不可になる。
