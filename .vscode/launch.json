{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frichy: Dev Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: Dev API",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run api:dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: UnitTest",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run UnitTest",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: Test UI",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test:ui",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: Test API",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test:api",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: Test All",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: Typecheck",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run typecheck",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: Build",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Frichy: Dev Web + API",
      "configurations": [
        "Frichy: Dev Web",
        "Frichy: Dev API"
      ],
      "stopAll": true
    }
  ]
}
