{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frichy: Dev Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: Dev API",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run api:dev",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Frichy: Start Postgres"
    },
    {
      "name": "Frichy: Dev DB",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose up -d postgres",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: Stop DB",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose stop postgres",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Frichy: UnitTest",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "UnitTest"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frichy: Test UI",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "test:ui"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frichy: Test API",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "test:api"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "Frichy: Start Postgres",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frichy: Test All",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "test"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "Frichy: Start Postgres",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frichy: Typecheck",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "typecheck"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frichy: Build",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "build"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Frichy: Dev Web + API",
      "configurations": [
        "Frichy: Dev Web",
        "Frichy: Dev API"
      ],
      "stopAll": true
    }
  ]
}
