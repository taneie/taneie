{
  "name": "frichy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./Frontend/scripts/nuxt-short-tmp.mjs dev Frontend --host 127.0.0.1 --port 5173",
    "start": "node backend/dist/interfaces/http/server.js",
    "build": "node ./Frontend/scripts/nuxt-short-tmp.mjs build Frontend",
    "preview": "node ./Frontend/scripts/nuxt-short-tmp.mjs preview Frontend --host 127.0.0.1 --port 5173",
    "typecheck": "node ./Frontend/scripts/nuxt-short-tmp.mjs typecheck Frontend",
    "dev:api": "npm run api:dev",
    "api:dev": "tsx backend/src/interfaces/http/server.ts",
    "api:build": "tsc -p backend/tsconfig.json",
    "api:start": "node backend/dist/interfaces/http/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:encrypt-pii": "tsx backend/scripts/encrypt-existing-pii.ts",
    "db:seed": "tsx backend/prisma/seed.ts",
    "deploy:build": "npm run db:generate && npm run generate && npm run api:build",
    "deploy:start": "npm run db:deploy && npm run db:seed && npm run api:start",
    "gcp:build": "npm run db:generate && npm run generate && npm run api:build",
    "gcp:start": "npm run api:start",
    "postinstall": "node ./Frontend/scripts/nuxt-short-tmp.mjs prepare Frontend",
    "generate": "node ./Frontend/scripts/nuxt-short-tmp.mjs generate Frontend",
    "deploy": "npm run generate && gh-pages -d Frontend/.output/public"
  },
  "prisma": {
    "seed": "tsx backend/prisma/seed.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/blob": "^2.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "nuxt": "^3.15.4",
    "pg": "^8.21.0",
    "sanitize-html": "^2.17.5",
    "vue": "^3.5.13",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "gh-pages": "^6.3.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vue-tsc": "^2.2.0"
  }
}
